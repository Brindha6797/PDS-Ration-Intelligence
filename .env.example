# ==============================================================================
# PUBLIC DISTRIBUTION SYSTEM (PDS) - RATION SHOP STOCK & ENTITLEMENT SYSTEM
# ROOT ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# NOTE: DO NOT commit real secrets, production credentials, or passwords here.
# Copy this file to .env and provide local operational credentials.

# ------------------------------------------------------------------------------
# 1. ORACLE DATABASE (ENTERPRISE / XE / CLOUD ATP)
# ------------------------------------------------------------------------------
# Hostname or IP of the Oracle Database Server
ORACLE_DB_HOST=localhost

# Oracle Net Listener Port (Default: 1521)
ORACLE_DB_PORT=1521

# Oracle Pluggable Database (PDB) Service Name or SID (e.g., XEPDB1, ORCLPDB, FREEPDB1)
ORACLE_DB_SERVICE_NAME=XEPDB1

# Dedicated Application Schema User (Created via database/01_create_schema_objects.sql)
ORACLE_DB_USERNAME=C##PDS_ADMIN

# Schema Password (Use strong alphanumeric password with special characters)
ORACLE_DB_PASSWORD=YourSecureOraclePasswordHere123!

# Hibernate / JPA Dialect (Oracle 12c+ / 19c / 21c / 23c)
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.OracleDialect

# HikariCP Connection Pool Settings
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=5
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=20
SPRING_DATASOURCE_HIKARI_IDLE_TIMEOUT=300000
SPRING_DATASOURCE_HIKARI_MAX_LIFETIME=1800000
SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=30000

# ------------------------------------------------------------------------------
# 2. SPRING BOOT BACKEND CONFIGURATION
# ------------------------------------------------------------------------------
# Server Port
SERVER_PORT=8080

# Context Path for REST APIs
SERVER_SERVLET_CONTEXT_PATH=/api/v1

# Stateless JWT Security Token (HMAC SHA-256 Secret - Min 256 bits)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# AI Intelligence Microservice URL (FastAPI Bridge)
AI_SERVICE_URL=http://localhost:8000/api/v1/ai

# Logging Level (INFO, WARN, DEBUG)
LOGGING_LEVEL_COM_WIPRO_PDS=INFO

# ------------------------------------------------------------------------------
# 3. PYTHON FASTAPI AI MICROSERVICE CONFIGURATION
# ------------------------------------------------------------------------------
# AI Service Host and Port
AI_HOST=0.0.0.0
AI_PORT=8000

# AI Service Environment (development, testing, production)
AI_ENV=development

# Anomaly Detection Sensitivity Parameters
ISOLATION_FOREST_CONTAMINATION=0.05
Z_SCORE_ANOMALY_THRESHOLD=2.5

# Demand Forecasting Settings
DEFAULT_FORECAST_DAYS=30
HISTORICAL_VELOCITY_WINDOW_DAYS=90

# ------------------------------------------------------------------------------
# 4. REACT FRONTEND (VITE) CONFIGURATION
# ------------------------------------------------------------------------------
# Port for the Vite development server
VITE_PORT=5173

# Reverse Proxy Target for Backend Spring Boot REST APIs
VITE_API_PROXY_TARGET=http://localhost:8080

# Government Portal Jurisdiction Details
VITE_APP_STATE=Tamil Nadu
VITE_APP_TALUK=Tambaram
VITE_APP_FPS_COUNT=120
VITE_APP_BENEFICIARY_COUNT=100000
